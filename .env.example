# Google OAuth client for Novabox (Google Cloud Console > APIs & Services > Credentials,
# type "Desktop app"). Copy this file to .env and fill both values, then rebuild.
# These are compiled into the app by src-tauri/build.rs; only VITE_-prefixed
# variables would ever reach the web frontend, so these stay in the Rust side.
NOVABOX_GOOGLE_CLIENT_ID=
NOVABOX_GOOGLE_CLIENT_SECRET=

# Optional. Where installed copies look for new versions, instead of the GitHub release
# feed in src-tauri/tauri.conf.json (plugins.updater.endpoints). Useful for a test feed.
NOVABOX_UPDATE_URL=
